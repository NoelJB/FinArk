<?xml version="1.0" encoding="UTF-8"?>
<!-- ============================================================================
// FINARK CORE PLATFORM CHASSIS SDK - JAVA COMPONENT MANIFEST
// Target File: packages/finark-core-java/pom.xml | BRS: BR-14 Alignment
// ============================================================================ -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    
    <groupId>com.finark</groupId>
    <artifactId>finark-core-java</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        
        <junit.version>6.0.3</junit.version> <!-- Aligned with Spring Boot 4.1.1 test dependencies -->
        <lettuce.version>7.5.2.RELEASE</lettuce.version>
        <jwt.version>4.4.0</jwt.version>
        <mockito.version>5.23.0</mockito.version>
    </properties>

    <dependencies>
        <!-- 🔌 High-performance non-blocking driver client for Valkey/Redis grids -->
        <dependency>
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
            <version>${lettuce.version}</version>

	    <!-- 🛡️ TRANSITIVE INSULATION: Drop the conflicting auth plugin from the engine entirely -->
	    <exclusions>
              <exclusion>
		<groupId>redis.clients.authentication</groupId>
		<artifactId>redis-authx-core</artifactId>
              </exclusion>
	    </exclusions>
        </dependency>
        
        <!-- 🔐 Cryptographic JSON Web Token parser token decoding matrix -->
        <dependency>
            <groupId>com.auth0</groupId>
            <artifactId>java-jwt</artifactId>
            <version>${jwt.version}</version>
        </dependency>
        
        <!-- 🧪 Automated Regression Unit Test Primitives (JUnit Jupiter) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        
        <!-- 🧪 Mock factory boundary isolation utilities -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.18.2</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>7.0.9</version>
            <scope>provided</scope> <!-- Provided ensures it uses the host Spring Boot runtime version -->
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <version>7.0.9</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>
</project>
